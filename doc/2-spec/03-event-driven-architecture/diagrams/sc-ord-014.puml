@startuml
title SC-ORD-014 — Order canceled by the customer
actor Customer as C
participant "Order\n(saga)" as O
participant "Inventory" as I
participant "Payment" as P
participant "Payment\nprovider" as PSP
participant "Notification" as N

C -> O : CancelOrder
note over O : order CANCELING\nsaga RETURNING_STOCK
O --> C : accepted
O ->> I : ReturnStock
I ->> O : StockReturned
note over O : REFUNDING_PAYMENT
O ->> P : RefundPayment
P -> PSP : refund
PSP --> P : refunded
P ->> O : PaymentRefunded
note over O #C8E6C9 : COMPLETED\norder CANCELED
O ->> N : OrderCanceled
N ->> C : cancellation e-mail
@enduml

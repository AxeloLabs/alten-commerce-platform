@startuml
title SC-ORD-015 — Nobody can tell whether the payment was captured
actor Administrator as A
participant "Order\n(saga)" as O
participant "Inventory" as I
participant "Payment" as P
participant "Payment\nprovider" as PSP
participant "Notification" as N

O ->> P : ChargePayment
P -> PSP : charge
note over PSP #ECEFF1 : unreachable
P ->> O : PaymentOutcomeUnknown
note over O : CANCELING_PAYMENT
O ->> P : CancelPayment
P -> PSP : cancel
note over P : no answer: the request is kept\nand tried again, with growing delays
... review deadline ...
O -> O : review deadline reached
note over O #FFF8E1 : SUSPENDED, remembers CANCELING_PAYMENT\norder UNDER_REVIEW\npayment unknown, stock held
O ->> N : OrderPutUnderReview
== the provider is reachable again ==
A -> O : RejectOrderUnderReview, with a comment
note over O : CANCELING_PAYMENT\nrejection decided: ADMIN_DECISION
O ->> P : CancelPayment
P -> PSP : cancel
PSP --> P : canceled
P ->> O : PaymentCanceled
O ->> I : ReleaseReservation
note over O #FFCDD2 : COMPENSATED\norder REJECTED, ADMIN_DECISION
O ->> N : OrderRejected
@enduml

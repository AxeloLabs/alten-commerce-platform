@startuml
!include <C4/C4_Component>
title Components of the order service

Container(gw, "Web gateway", "Spring Cloud Gateway")
Container(catalog, "Catalog service", "Spring Boot")
Container(cartsvc, "Cart service", "Spring Boot")
ContainerDb(db, "Order database", "PostgreSQL")
ContainerQueue(bus, "Pub/Sub", "Topics and subscriptions")

Container_Boundary(order, "Order service") {
  Component(rest, "REST controllers", "Inbound adapter", "Checkout, order history, cancellation, fulfillment, review decisions")
  Component(sub, "Message subscribers", "Inbound adapter", "Inventory and payment events")
  Component(sched, "Deadline task", "Inbound adapter", "Turns a passed deadline into a call")
  Component(app, "Use cases", "Application", "Place, cancel, ship, deliver, decide, handle a saga event, read orders")
  Component(dom, "Domain", "Plain Java", "Order, PlaceOrderSaga, CancelOrderSaga, value objects")
  Component(uow, "Unit of work", "Outbound adapter, JPA", "Saves aggregate, inbox and outbox in one transaction")
  Component(relay, "Outbox relay", "Outbound adapter", "Publishes saved messages, in order")
  Component(clients, "Catalog and cart clients", "Outbound adapter, HTTP", "Read prices and the cart at checkout")
}

Rel(gw, rest, "Calls", "REST")
Rel(bus, sub, "Delivers")
Rel(rest, app, "Calls")
Rel(sub, app, "Calls")
Rel(sched, app, "Calls")
Rel(app, dom, "Loads, asks, gets a decision")
Rel(app, uow, "Through a port")
Rel(app, clients, "Through ports")
Rel(uow, db, "Reads and writes", "SQL")
Rel(sched, db, "Finds due sagas", "SQL")
Rel(relay, db, "Reads the outbox", "SQL")
Rel(relay, bus, "Publishes")
Rel(clients, catalog, "Reads", "REST")
Rel(clients, cartsvc, "Reads", "REST")

SHOW_LEGEND()
@enduml

@startuml
title Lifecycle of a stock reservation

hide empty description

state "REJECTED" as REJECTED_R
state RETURNED

[*] --> HELD : all lines available\nreserved += quantities
[*] --> REJECTED_R : one line not available,\nor request received too late\nnothing reserved
HELD --> CONFIRMED : order paid\non hand -= quantities\nreserved -= quantities
HELD --> RELEASED : order rejected\nreserved -= quantities
HELD --> EXPIRED : lifetime elapsed\nreserved -= quantities
EXPIRED --> CONFIRMED : order paid after the expiry,\nstock still available\non hand -= quantities
CONFIRMED --> RETURNED : order canceled, or rejected\nafter the confirmation\non hand += quantities
CONFIRMED --> [*]
RELEASED --> [*]
EXPIRED --> [*]
REJECTED_R --> [*]
RETURNED --> [*]
@enduml

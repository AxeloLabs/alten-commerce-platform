@startuml
title Outcomes of an order placement

start
:Customer submits the checkout;
if (Cart unchanged since the review?) then (no)
  :Show the differences,\nback to the cart;
  stop
else (yes)
endif
:Create the order PENDING;
:Reserve the stock;
switch (Stock reservation)
case (not available)
  :REJECTED\nOUT_OF_STOCK; <<#FFCDD2>>
  stop
case (no answer before\nthe order deadline)
  :Send a release,\njust in case;
  :REJECTED\nTIMED_OUT; <<#FFCDD2>>
  stop
case (reserved)
endswitch
:Charge the payment;
switch (Payment)
case (refused)
  :Release the stock;
  :REJECTED\nPAYMENT_REFUSED; <<#FFCDD2>>
  stop
case (no answer before\nthe order deadline)
  :Cancel the payment\nat the provider;
  switch (Cancellation)
  case (canceled)
    :Release the stock;
    :REJECTED\nTIMED_OUT; <<#FFCDD2>>
    stop
  case (no answer before\nthe review delay)
    :UNDER_REVIEW; <<#FFF8E1>>
    stop
  case (already captured)
  endswitch
case (captured)
endswitch
note right
  The payment is captured:
  the order now goes forward.
  The only way back is a refund.
end note
:Confirm the reservation\n(retried);
switch (Stock)
case (secured)
  :CONFIRMED; <<#C8E6C9>>
  :Update the cart,\nsend the e-mail;
  stop
case (not secured before\nthe review delay)
  :UNDER_REVIEW; <<#FFF8E1>>
  stop
case (reservation expired\nand stock gone)
  :Refund the payment;
  if (Refunded?) then (yes)
    :REJECTED\nOUT_OF_STOCK; <<#FFCDD2>>
    stop
  else (keeps failing)
    :UNDER_REVIEW; <<#FFF8E1>>
    stop
  endif
endswitch
@enduml

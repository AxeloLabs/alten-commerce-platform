@startuml
title Inventory context: domain model
hide empty members

class StockItem <<aggregate root>> {
  sku : Sku
  onHand : StockLevel
  reserved : StockLevel
  version : long
  --
  available() : StockLevel
  hold(quantity)
  confirm(quantity)
  release(quantity)
  giveBack(quantity)
  adjust(delta, reason, administrator)
}
class Reservation <<aggregate root>> {
  reservationId : ReservationId
  orderId : OrderId
  sagaId : SagaId
  status : ReservationStatus
  expiresAt : Instant
  version : long
  --
  confirm()
  release()
  expire(now)
  giveBack()
}
class ReservationLine <<value object>> {
  sku : Sku
  quantity : Quantity
}
enum ReservationStatus {
  HELD
  REJECTED
  CONFIRMED
  RELEASED
  EXPIRED
  RETURNED
}
class StockMovement <<entity>> {
  movementId
  sku : Sku
  quantity : int
  cause : MovementCause
  orderId [0..1]
  administrator [0..1]
  reason [0..1]
  at : Instant
}
enum MovementCause {
  ADJUSTMENT
  ORDER_CONFIRMED
  STOCK_RETURNED
}
class ReservationPolicy <<domain service>> {
  reserveAllOrNothing(orderId, lines, stock, expiresAt, now) : Reservation
}

Reservation "1" *-- "1..50" ReservationLine
Reservation --> ReservationStatus
StockMovement --> MovementCause
ReservationPolicy ..> StockItem : holds on every line,\nor on none
ReservationPolicy ..> Reservation : creates, HELD or REJECTED
StockItem ..> StockMovement : records
@enduml

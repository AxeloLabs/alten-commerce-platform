@startuml
title Payment context: domain model
hide empty members

class Payment <<aggregate root>> {
  paymentId : PaymentId
  orderId : OrderId
  placementSagaId : SagaId
  amount : Money
  status : PaymentStatus
  providerReference : String
  refusalReason : String [0..1]
  version : long
  --
  recordCapture()
  recordRefusal(reason)
  recordUnknown()
  recordCancellation()
  recordRefund()
  mustCallProviderFor(request) : boolean
  eventOfStatus() : Event
}
enum PaymentStatus {
  PENDING
  CAPTURED
  REFUSED
  UNKNOWN
  CANCELED
  REFUNDED
}
class ProviderAttempt <<entity>> {
  kind : CHARGE, CANCEL or REFUND
  startedAt : Instant
  outcome : String [0..1]
  endedAt : Instant [0..1]
}
interface PaymentProvider <<port>> {
  charge(reference, amount, token) : ProviderAnswer
  cancel(reference) : ProviderAnswer
  refund(reference, amount) : ProviderAnswer
}
class Money <<value object>> {
  amount : BigDecimal
  currency : EUR
}

Payment "1" *-- "0..*" ProviderAttempt
Payment --> PaymentStatus
Payment --> Money
Payment ..> PaymentProvider : through the application service

note bottom of Payment
  Every request is answered from the status
  (document 02-03). The provider reference is
  derived from the placement saga identifier
  and is the same for charge, cancel and refund.
end note
@enduml

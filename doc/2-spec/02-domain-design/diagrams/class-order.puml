@startuml
title Order context: domain model
hide empty members

class Order <<aggregate root>> {
  orderId : OrderId
  orderNumber : OrderNumber
  customerId : CustomerId
  customerEmail : EmailAddress
  checkoutId : CheckoutId
  status : OrderStatus
  rejectionReason : RejectionReason [0..1]
  total : Money
  shippingAddress : ShippingAddress
  version : long
  --
  place(customer, cartLines, prices, address)
  confirm()
  reject(reason)
  putUnderReview(cause)
  startCancellation()
  completeCancellation()
  ship(administrator)
  deliver(administrator)
}
class OrderLine <<value object>> {
  sku : Sku
  productName : String
  unitPrice : Money
  quantity : Quantity
  lineTotal() : Money
}
class StatusChange <<value object>> {
  status : OrderStatus
  at : Instant
  by : Actor
  comment : String [0..1]
}
enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  UNDER_REVIEW
  CANCELING
  CANCELED
  SHIPPED
  DELIVERED
}
enum RejectionReason {
  OUT_OF_STOCK
  PAYMENT_REFUSED
  TIMED_OUT
  ADMIN_DECISION
}
class PlaceOrderSaga <<aggregate root>> {
  sagaId : SagaId
  orderId : OrderId
  state : PlaceOrderState
  rememberedStep : PlaceOrderState [0..1]
  knownPayment : KnownPayment
  knownStock : KnownStock
  decidedRejection : RejectionReason [0..1]
  paymentToken : PaymentToken [0..1]
  orderDeadline : Instant [0..1]
  reviewDeadline : Instant [0..1]
  lastFailure : String [0..1]
  version : long
  --
  start() : Decision
  on(event) : Decision
  onOrderDeadline() : Decision
  onReviewDeadline() : Decision
  retry(administrator, comment) : Decision
  confirm(administrator, comment) : Decision
  reject(administrator, comment) : Decision
}
class CancelOrderSaga <<aggregate root>> {
  sagaId : SagaId
  orderId : OrderId
  state : CancelOrderState
  rememberedStep : CancelOrderState [0..1]
  knownPayment : KnownPayment
  knownStock : KnownStock
  reviewDeadline : Instant [0..1]
  lastFailure : String [0..1]
  version : long
  --
  start() : Decision
  on(event) : Decision
  onReviewDeadline() : Decision
  retry(administrator, comment) : Decision
}
enum KnownPayment {
  NOT_REQUESTED
  REQUESTED
  CAPTURED
  REFUSED
  CANCELED
  REFUNDED
}
enum KnownStock {
  REQUESTED
  HELD
  REJECTED
  CONFIRMED
  LOST
  RELEASED
  RETURNED
}
class Decision <<value object>> {
  orderTransition [0..1]
  commands : List<Command>
  events : List<Event>
  alert [0..1]
}

Order "1" *-- "1..50" OrderLine
Order "1" *-- "1..*" StatusChange
Order --> OrderStatus
Order --> RejectionReason
PlaceOrderSaga "1" ..> "1" Order : decides for
CancelOrderSaga "0..1" ..> "1" Order : decides for
PlaceOrderSaga ..> Decision : returns
CancelOrderSaga ..> Decision : returns
PlaceOrderSaga --> KnownPayment
PlaceOrderSaga --> KnownStock
CancelOrderSaga --> KnownPayment
CancelOrderSaga --> KnownStock
@enduml
